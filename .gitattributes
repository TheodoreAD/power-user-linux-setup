# Line endings: the repo stores LF; text files are also checked out as LF on every OS,
# so synced copies (Syncthing, other machines) are identical and diffs don't flip CRLF/LF.
# Overrides core.autocrlf for this repo. Windows editors (VS Code, Notepad, Obsidian) and
# PowerShell 5.1/7 all handle LF. Here it is also what keeps a Windows checkout passing the gate:
# dprint's markdown plugin and every shell script run in WSL or Linux expect LF.
* text=auto eol=lf

# Windows batch files can misbehave with LF: keep them CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary: never convert or diff as text
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.7z   binary
*.mp3  binary
*.mp4  binary
*.mov  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.docx binary
*.xlsx binary
*.pptx binary
