{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 120,
  "markdown": {
    "textWrap": "always",
    "lineWidth": 100
  },
  "excludes": [
    ".vscode",
    "uv.lock",
    // Helm chart templates are Go templates, not YAML — `{{- include ... }}` at a value position
    // is a parse error to any real YAML parser, dprint's pretty_yaml included. A chart's own
    // Chart.yaml and values.yaml are plain YAML and stay formatted; only templates/ is exempt.
    "**/templates/*.yaml",
    "**/templates/*.yml"
  ],
  // Remote plugins, so `dprint` is the one gate step that needs the network on a machine that has
  // never run it — fetched once into ~/.cache/dprint (DPRINT_CACHE_DIR), then offline forever. CI
  // is a fresh machine every run, so CI downloads them every run. See contributing/quality-gate.md.
  //
  // The `@<sha256>` suffix is dprint's own integrity check, and it is enforced: a mismatch fails
  // with "Invalid checksum specified in configuration file" and exit 12, verified 2026-09-06. Only
  // the checksum makes fetching an executable over the network on every CI run defensible — without
  // it, whatever plugins.dprint.dev serves is what formats every consumer's code. Recompute with
  // `curl -sL <url> | sha256sum` when bumping a plugin version.
  "plugins": [
    "https://plugins.dprint.dev/json-0.23.0.wasm@3e1f1b7c1427df6bd8981a11aaa2c466fde8d1115e9dde4c652130458539443c",
    "https://plugins.dprint.dev/toml-0.7.0.wasm@0126c8112691542d30b52a639076ecc83e07bace877638cee7c6915fd36b8629",
    "https://plugins.dprint.dev/markdown-0.22.1.wasm@4906fbb038977732aae0e216e4b0b957e2722f8d79282660ccb36d27dd051f17",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm@40a2fdda7040317eb1b23520f3a00769a5571eedb049c4ca9175c1b9eeba01ae",
    "https://plugins.dprint.dev/dockerfile-0.4.1.wasm@dc9536b1d744897d13ad3d0621f551f8f362143f9f6d06ff0781e0e0497cb794"
  ]
}
