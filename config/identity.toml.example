# Personal identity data — DO NOT commit this file.
# Copy to ~/.config/power-user-linux-setup/identity.toml and fill in your details.
#
# Only need one name/email and one ~/projects/<dir>/? Run `inv identity.init` instead — an
# interactive wizard that writes the minimal version of this same file for you, no hand-editing
# required. This example is for the full multi-directory/multi-account case.
#
# Used by:
#   inv git.configure  — per-directory git identities (~/projects/<directory>/.gitconfig)
#   inv ssh.create-keys       — create one ed25519 key per unique email
#   inv ssh.configure  — write ~/.ssh/config
#   inv ssh.forward    — ssh-copy-id to non-git server hosts
#   inv ssh.add        — ssh-add all keys for this machine

# One entry per projects directory.
# Each directory gets its own .gitconfig with user.name and user.email.
# git automatically picks the right identity based on where the repo lives.
#
# `directory` is either a bare relative name — joined under ~/projects/, as below — or an
# absolute path (optionally starting with ~, expanded), used as-is for a location outside
# ~/projects/ entirely, e.g. directory = "~/projects/" (repos directly in ~/projects/, no
# subdirectory) or directory = "~/code/clientA".

[[git_profiles]]
directory = "github.com-personal"
name      = "Jane Smith"
email     = "jane.smith@gmail.com"

[[git_profiles]]
directory = "github.com-work"
name      = "Jane Smith"
email     = "jane.smith@work.com"

[[git_profiles]]
directory = "gitlab.com-personal"
name      = "Jane Smith"
email     = "jane.smith@gmail.com"

# One entry per host you connect to.
# One ed25519 key is created per unique email — not per host.
# Set user = "git" for code hosting platforms (GitHub, GitLab).
# Set user to your login name for terminal/server access.
#
# For multiple accounts on the same platform, use a distinct alias
# and set hostname to the real address. Clone via the alias:
#   git clone git@github-work:user/repo.git

[[ssh_hosts]]
user     = "git"
alias    = "github.com"
hostname = "github.com"
email    = "jane.smith@gmail.com"

[[ssh_hosts]]
user     = "git"
alias    = "github-work"
hostname = "github.com"
email    = "jane.smith@work.com"

[[ssh_hosts]]
user     = "git"
alias    = "gitlab.com"
hostname = "gitlab.com"
email    = "jane.smith@gmail.com"

# Server hosts — inv ssh.forward will run ssh-copy-id for these.
[[ssh_hosts]]
user     = "jsmith"
alias    = "myserver"
hostname = "10.11.12.13"
email    = "jane.smith@work.com"

# Optional — only needed if `inv proxy.check`/`inv proxy.install`'s auto-discovery guesses wrong
# or finds nothing (e.g. the corporate proxy isn't reflected in any env var, /etc/environment, or
# GNOME's proxy setting on this machine). Never put credentials here — proxy.install captures
# those separately (GUI prompt / terminal / PULSE_PROXY_PASSWORD_FILE) and stores them in the OS
# keyring, never in this file. See docs/corporate-proxy.md.
# [proxy]
# host    = "proxy.corp.example.com"
# port    = 8080
# noproxy = "*.corp.example.com,10.0.0.0/8"
#
# The local daemon answers this machine's loopback only, which is right until something in a
# container needs it — 127.0.0.1 in there is the container's own. `gateway` opens it past loopback
# and `allow` says to whom; `gateway` without a narrowed `allow` is refused, because the daemon is
# unauthenticated to its clients and would hand anything that can route here authenticated egress
# through your corporate account. See docs/corporate-proxy.md, "Reaching the daemon from a
# container".
# gateway = true
# allow   = "172.17.0.0/16"   # docker's default bridge, and nothing else

# Optional — corporate TLS-inspection root CA, if this network has one (`inv certs.install`).
# Auto-detected by content, not file extension: PEM (-----BEGIN CERTIFICATE-----), raw DER, or a
# Windows PKCS#7 .p7b/.p7c (common from AD Certificate Services) are all accepted as-is.
# See docs/certs.md.
# [certs]
# bundle = "/home/jsmith/Downloads/CorporateRootCA.crt"
#
# Root + a separate intermediate — use a list instead:
# bundle = [
#   "/home/jsmith/Downloads/CorporateRootCA.crt",
#   "/home/jsmith/Downloads/CorporateIntermediateCA.crt",
# ]

# Optional — docker on a corporate network (`inv docker.configure-corporate`). Every key is
# independent: what you leave out is simply not configured. See docs/docker.md.
# [docker]
# registry_mirrors = ["https://registry.corp.example.com"]  # pull-through mirror, daemon.json
#
# The daemon's own outbound proxy. dockerd is a systemd service and inherits nothing from a shell,
# so this becomes a drop-in. 127.0.0.1 is right here — dockerd runs in the host's network
# namespace, so a local Px is reachable.
# proxy = "http://127.0.0.1:3128"
#
# What processes *inside* containers see. Deliberately a separate key: 127.0.0.1 in a container is
# that container's own loopback, so this has to be the bridge gateway — and Px only answers there
# if it was started in gateway mode.
# container_proxy = "http://172.17.0.1:3128"
# no_proxy = "localhost,127.0.0.1,*.corp.example.com"
#
# Registries that need the [certs] bundle above at /etc/docker/certs.d/<host>/ca.crt — docker does
# not read the OS trust store, so `inv certs.install` alone does not cover a registry pull.
# registries = ["registry.corp.example.com:5000"]
