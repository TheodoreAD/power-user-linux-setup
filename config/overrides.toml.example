# Machine-local overrides — copy to ~/.config/power-user-linux-setup/overrides.toml
#
# setup.toml's `enabled` is the default for every machine that clones this repo. This file is how
# one machine disagrees, in setup.toml's own shape. Only `enabled` is honoured, and only for a
# package setup.toml already declares — every package *definition* stays in git where it can be
# reviewed.
#
# Precedence: setup.toml -> this file -> PULSE_EXCLUDE_TAGS. The environment is last and absolute,
# because tags describe capability (a container with no display server genuinely cannot run a `gui`
# package) while this file only describes intent.
#
# Deliberately outside git, and not backed up by anything in this repo: preserving a home directory
# is the user's own job. What PULSE guarantees is the stability of its defaults.

# Turn on a workaround that ships off for everyone else. This pair forces Chrome onto XWayland,
# working around an NVIDIA-driver + native-Wayland bug where protected/DRM video (Netflix) renders
# black while audio keeps playing. Enable both or neither — the autostart half is what makes the
# launcher half take effect. See plans/2026-08-24-chrome-ozone-x11-launcher-coverage.md.
# [packages.google-chrome-x11]
# enabled = true
#
# [packages.google-chrome-x11-autostart]
# enabled = true

# Turn off something this repo enables by default.
# [packages.atuin]
# enabled = false
