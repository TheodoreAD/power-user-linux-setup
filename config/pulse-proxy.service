[Unit]
Description=PULSE local proxy (Px) - unauthenticated localhost front for the corporate proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Optional (the leading -): written only by `inv proxy.install --keyring-fallback`, on a machine
# with no Secret Service for Px to read its credential out of. It carries PYTHON_KEYRING_BACKEND
# and nothing else — no secret. Scoping the backend choice to this unit is the point: the
# alternative, ~/.config/python_keyring/keyringrc.cfg, is global to every keyring consumer on the
# machine and would silently downgrade unrelated tools.
EnvironmentFile=-%h/.config/power-user-linux-setup/proxy.env
# %h is systemd's own specifier for the user's home directory, so this file stays a static,
# diffable artifact instead of a string interpolated at write time — which is what let it live in
# tasks/proxy.py as a module constant with no manifest entry and no redeploy path.
ExecStart=%h/.local/bin/px
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
